+// HVP-LR diagnostic build: emit [hvp-lr] traces unconditionally so we can
+// distinguish "CUDA backend loaded but device not attached" from
+// "model offloaded to GPU but inference fell back to CPU" in production
+// stderr. Set HVP_LR_QUIET=1 to suppress llama internal logs (the
+// [hvp-lr] lines remain regardless).
+static void hvp_lr_log(const char* fmt, ...) {
+    va_list ap;
+    va_start(ap, fmt);
+    std::fputs("[hvp-lr] ", stderr);
+    std::vfprintf(stderr, fmt, ap);
+    std::fputc('\n', stderr);
+    std::fflush(stderr);
+    va_end(ap);
+}
+
+static const char* hvp_lr_dev_type_str(ggml_backend_dev_t dev) {
+    switch (ggml_backend_dev_type(dev)) {
+        case GGML_BACKEND_DEVICE_TYPE_CPU:   return "CPU";
+        case GGML_BACKEND_DEVICE_TYPE_GPU:   return "GPU";
+        case GGML_BACKEND_DEVICE_TYPE_ACCEL: return "ACCEL";
+        default: return "UNKNOWN";
+    }
+}

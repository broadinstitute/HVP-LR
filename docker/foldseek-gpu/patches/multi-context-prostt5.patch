+// HVP-LR: returns free VRAM bytes for the first GPU device matched by the
+// device string. Used by structcreatedb.cpp to size n_ubatch dynamically.
+// device argument follows the same syntax llama.cpp uses: "auto" / "" /
+// "all" pick the first enumerated GPU; a comma-separated list picks the
+// first entry. Returns 0 on any failure (caller should fall back to a
+// conservative default).
+size_t ProstT5::getDeviceFreeBytes(const std::string& device) {
+    ggml_backend_dev_t target = nullptr;
+    bool anyGpu = device.empty() || device == "auto" || device == "all";
+    std::string first = device;
+    size_t comma = device.find(',');
+    if (comma != std::string::npos) {
+        first = device.substr(0, comma);
+    }
+    if (!anyGpu) {
+        target = ggml_backend_dev_by_name(first.c_str());
+        if (target != nullptr &&
+            ggml_backend_dev_type(target) != GGML_BACKEND_DEVICE_TYPE_GPU) {
+            target = nullptr;
+        }
+    }
+    if (target == nullptr) {
+        for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+            ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+            if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+                target = dev;
+                break;
+            }
+        }
+    }
+    if (target == nullptr) {
+        hvp_lr_log("ProstT5::getDeviceFreeBytes: no GPU device found for '%s'",
+                   device.c_str());
+        return 0;
+    }
+    size_t freeB = 0;
+    size_t totalB = 0;
+    ggml_backend_dev_memory(target, &freeB, &totalB);
+    hvp_lr_log("ProstT5::getDeviceFreeBytes: %s free=%zu total=%zu",
+               ggml_backend_dev_name(target), freeB, totalB);
+    return freeB;
+}
+
 void ProstT5::perf() {
     llama_perf_context_print(ctx);
 }
